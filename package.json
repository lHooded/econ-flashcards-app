{
  "name": "econ-flashcards-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:deck && npm run validate:exam-questions && npm run validate:calculations && npm run validate:knowledge && npm run validate:guided-learning",
    "build": "vite build",
    "preview": "vite preview",
    "validate:deck": "tsx scripts/validate-deck.ts",
    "validate:exam-questions": "tsx scripts/validate-exam-questions.ts",
    "validate:calculations": "tsx scripts/validate-calculations.ts",
    "validate:knowledge": "tsx scripts/validate-knowledge.ts",
    "validate:guided-learning": "tsx scripts/validate-guided-learning.ts",
    "validate:sync-deploy-config": "tsx scripts/validate-sync-deploy-config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"sync-worker/**/*.{ts,jsonc}\" \"scripts/**/*.ts\" \"exam_questions/**/*.json\" \"knowledge/**/*.json\" eslint.config.js vite.config.ts vitest.config.ts package.json index.html README.md docs/SYNC.md docs/GENERATED_CALCULATIONS.md docs/KNOWLEDGE_GRAPH*.md docs/GUIDED_CRAM.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"sync-worker/**/*.{ts,jsonc}\" \"scripts/**/*.ts\" \"exam_questions/**/*.json\" \"knowledge/**/*.json\" eslint.config.js vite.config.ts vitest.config.ts package.json index.html README.md docs/SYNC.md docs/GENERATED_CALCULATIONS.md docs/KNOWLEDGE_GRAPH*.md docs/GUIDED_CRAM.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:dev": "wrangler dev --config sync-worker/wrangler.jsonc",
    "sync:typecheck": "tsc -p sync-worker/tsconfig.json --noEmit",
    "sync:test": "vitest run --config sync-worker/vitest.config.ts sync-worker/src",
    "sync:integration-test": "vitest run --config sync-worker/vitest.integration.config.ts",
    "sync:deploy": "wrangler deploy --config sync-worker/wrangler.jsonc"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
