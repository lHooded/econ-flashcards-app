{
  "name": "econ-flashcards-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:deck && npm run validate:exam-questions && npm run validate:calculations",
    "build": "vite build",
    "preview": "vite preview",
    "validate:deck": "tsx scripts/validate-deck.ts",
    "validate:exam-questions": "tsx scripts/validate-exam-questions.ts",
    "validate:calculations": "tsx scripts/validate-calculations.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"exam_questions/**/*.json\" eslint.config.js vite.config.ts vitest.config.ts package.json index.html README.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"exam_questions/**/*.json\" eslint.config.js vite.config.ts vitest.config.ts package.json index.html README.md",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  }
}
