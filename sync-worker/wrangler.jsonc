{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "econ-flashcards-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_GROUPS",
        "class_name": "SyncGroup",
      },
    ],
  },
  "exports": {
    "SyncGroup": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "ratelimits": [
    {
      "name": "CREATION_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "GROUP_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
}
