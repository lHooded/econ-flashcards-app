{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "econ-flashcards-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_GROUPS",
        "class_name": "SyncGroup",
      },
    ],
  },
  "exports": {
    "SyncGroup": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
